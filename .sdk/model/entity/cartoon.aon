# Entity: cartoon

main: kit: entity: cartoon: {

  alias: field: {}

  fields: [
    {
      name: "creator"
      req: false
      short: "Creator(s) of the cartoon"
      type: "`$ARRAY`"
    }
    {
      name: "episodes"
      req: false
      short: "Number of episodes"
      type: "`$INTEGER`"
    }
    {
      name: "genre"
      req: false
      short: "Genre(s) of the cartoon"
      type: "`$ARRAY`"
    }
    {
      name: "id"
      req: false
      short: "Unique identifier for the cartoon"
      type: "`$INTEGER`"
    }
    {
      format: "uri"
      name: "image"
      req: false
      short: "URL to the cartoon's image"
      type: "`$STRING`"
    }
    {
      name: "rating"
      req: false
      short: "Rating of the cartoon"
      type: "`$STRING`"
    }
    {
      name: "runtime_in_minutes"
      req: false
      short: "Runtime of the cartoon episode in minutes"
      type: "`$INTEGER`"
    }
    {
      name: "title"
      req: false
      short: "Title of the cartoon"
      type: "`$STRING`"
    }
    {
      name: "year"
      req: false
      short: "Year the cartoon was released"
      type: "`$INTEGER`"
    }
  ]

  id: {
    field: "id"
    name: "id"
  }

  name: "cartoon"
  op: {
    list: {
      name: "list"
      points: [
        {
          method: "GET"
          orig: "/cartoons/cartoons2D"
          segments: [
            {
              lit: "cartoons"
            }
            {
              lit: "cartoons2D"
            }
          ]
          select: {
            "$action": "cartoons2_d"
          }
          transform: {
            req: "`reqdata`"
            res: "`body`"
          }
        }
        {
          method: "GET"
          orig: "/cartoons/cartoons3D"
          segments: [
            {
              lit: "cartoons"
            }
            {
              lit: "cartoons3D"
            }
          ]
          select: {
            "$action": "cartoons3_d"
          }
          transform: {
            req: "`reqdata`"
            res: "`body`"
          }
        }
      ]
    }
  }



}
